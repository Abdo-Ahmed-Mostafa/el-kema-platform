# Approved native build scripts are declared in pnpm-workspace.yaml
# (onlyBuiltDependencies: @parcel/watcher, @swc/core, esbuild).
#
# Production/CI installers can still hard-fail on an ignored build script
# (ERR_PNPM_IGNORED_BUILDS, exit 1) when strictDepBuilds is on. We only run the
# three trusted builds above, so a skipped build should be a notice, not a
# failed deploy — disable the strict gate so `pnpm install` succeeds in prod.
strict-dep-builds=false
